---
/**
 * SidebarLink — a leaf row: `<a class="nb-sidebar-link">Label</a>`, with an
 * inner span only when a badge or the `leading` slot needs one. The row's
 * styling is the `nb-sidebar-link` class in `src/styles/globals.css`
 * ("Sidebar rows").
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import { Badge } from "@/components/ui/badge";
import type { SidebarBadge } from "@cloudflare/nimbus-docs/types";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

interface Props extends HTMLAttributes<"a"> {
  label: string;
  href: string;
  isCurrent?: boolean;
  badge?: SidebarBadge;
}

const { label, href, isCurrent, badge, class: className, ...attrs } = Astro.props;
const resolvedHref = withBase(href, import.meta.env.BASE_URL);
const hasLeading = Astro.slots.has("leading");
const plain = !hasLeading && !badge;
---

<a
  href={resolvedHref}
  aria-current={isCurrent ? "page" : undefined}
  data-nb-sidebar-link
  class={cn("nb-sidebar-link", className)}
  {...attrs}
>
  {plain ? (
    label
  ) : (
    <Fragment>
      <slot name="leading" />
      <span class="break-words">{label}</span>
      {badge &&
        (typeof badge === "string" ? (
          <Badge text={badge} />
        ) : (
          <Badge text={badge.text} variant={badge.variant} />
        ))}
    </Fragment>
  )}
</a>
