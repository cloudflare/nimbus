---
/**
 * PaginationLink — one half of the pagination bar: a caption, the page title
 * (the default slot), and the key that reaches it.
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import PaginationKey from "./PaginationKey.astro";

interface Props extends Omit<HTMLAttributes<"a">, "rel"> {
  rel: "prev" | "next";
  href: string;
  /** Caption above the title. Defaults to "Previous" or "Next". */
  label?: string;
}

const { rel, href, label, class: className, ...attrs } = Astro.props;
const isNext = rel === "next";
const caption = label ?? (isNext ? "Next" : "Previous");
---

<a
  href={href}
  rel={rel}
  data-nb-pagination-item
  data-nb-pagination-key={isNext ? "]" : "["}
  data-slot="pagination-link"
  class={cn(
    "nb-pagination-link relative flex min-w-0 flex-1 items-center gap-3 rounded-full py-1 no-underline",
    "focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring",
    isNext ? "justify-end pe-2.5 ps-5 text-end" : "pe-5 ps-2.5",
    className,
  )}
  {...attrs}
>
  {!isNext && <PaginationKey>[</PaginationKey>}
  <span class="min-w-0">
    <span data-slot="pagination-label" class="block text-[0.6875rem] leading-4 text-muted-foreground">{caption}</span>
    <span data-slot="pagination-title" class="nb-pagination-title block text-sm leading-5 font-medium text-foreground"><slot /></span>
  </span>
  {isNext && <PaginationKey>]</PaginationKey>}
</a>

<style>
  /* The rule between the halves; it fades while either half is highlighted. */
  .nb-pagination-link + .nb-pagination-link::before {
    content: "";
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    inset-inline-start: 0;
    width: 1px;
    background: var(--nb-border);
    transition: opacity 200ms;
  }
  :global([data-slot="pagination-bar"]:hover) .nb-pagination-link + .nb-pagination-link::before,
  :global([data-slot="pagination-bar"]:focus-within) .nb-pagination-link + .nb-pagination-link::before {
    opacity: 0;
  }

  /* Long titles get two lines on a phone and an ellipsis on wider screens. */
  .nb-pagination-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  @media (min-width: 40rem) {
    .nb-pagination-title {
      display: block;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  }
</style>
