---
/**
 * Step — a single step inside <Steps>. Alternative to authoring an
 * <ol><li> directly.
 *
 *   <Steps>
 *     <Step title="Install">Run <code>npm install</code>.</Step>
 *     <Step title="Configure">Edit <code>config.json</code>.</Step>
 *   </Steps>
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"li"> {
  title?: string;
}

const { title, class: className, ...attrs } = Astro.props;
---

<li data-step data-slot="step" class={cn(className)} {...attrs}>
  {(title || Astro.slots.has("title")) && <p data-slot="step-title" class="m-0 font-semibold text-foreground"><slot name="title">{title}</slot></p>}
  <div data-slot="step-content" class="mt-1 text-foreground [&_p:first-child]:mt-0 [&_p:last-child]:mb-0">
    <slot />
  </div>
</li>
