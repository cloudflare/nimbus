---
/**
 * ApiDeferredSchema — a large body whose nested fields load after the page,
 * through a server island. Until then, and without JavaScript, it shows the
 * top-level fields and points to the page's Markdown, which has them all.
 */
import ApiSchemaIsland from "./ApiSchemaIsland.astro";
import { withBase, type deferApiSchema } from "@cloudflare/nimbus-docs/runtime";

interface Props {
  deferred: NonNullable<ReturnType<typeof deferApiSchema>>;
  markdownUrl?: string;
  as?: "h2" | "h3" | "h4";
  title?: string;
  badge?: string;
  required?: boolean;
}

const { deferred, markdownUrl, ...list } = Astro.props;
---

<ApiSchemaIsland server:defer {...deferred.island} {...list}>
  <Fragment slot="fallback">
    <ApiSchemaIsland view={deferred.fallback} {...list} />
    <noscript>
      <p class="mt-2 text-sm text-muted-foreground">
        Nested fields need JavaScript.
        {markdownUrl && <a href={withBase(markdownUrl, import.meta.env.BASE_URL)} class="underline underline-offset-2">Read the full schema in Markdown</a>}
      </p>
    </noscript>
  </Fragment>
</ApiSchemaIsland>
