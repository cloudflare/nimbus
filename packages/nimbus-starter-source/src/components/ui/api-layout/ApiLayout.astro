---
/**
 * ApiLayout — the three-column reference shell (nav · content · code rail),
 * composing ApiSidebar + ApiFieldList + ApiCodeRail. It renders any
 * `ApiPageProps` by kind, reading the frozen view-model only. Drop it inside a
 * page that provides the document shell; widths inherit the site's layout
 * tokens (`--nb-sidebar-width`, `--nb-content-max`, `--nb-code-rail-width`).
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { ApiSidebar } from "@/components/ui/api-sidebar";
import ApiMethodChip from "@/components/ui/api-sidebar/ApiMethodChip.astro";
import { SidebarFilter, SidebarLink } from "@/components/ui/sidebar";
import { ApiCodeRail } from "@/components/ui/api-code-rail";
import { Banner } from "@/components/ui/banner";
import ApiBody from "./ApiBody.astro";
import { cn } from "@/lib/cn";
import { getApiVersionHead, getVersionStatus, navBuildId, navStateScript, withBase } from "@cloudflare/nimbus-docs/runtime";
import type { ApiNav, ApiPageProps } from "@cloudflare/nimbus-docs/api";

interface Props {
  page: ApiPageProps;
  nav: ApiNav;
  /** API family + this page's version/coordinate — enables the version
   *  picker and the deprecated-version banner. Omit for an unversioned API. */
  collection?: string;
  version?: string | null;
  coordinate?: string;
}

const { page, nav, collection, version, coordinate } = Astro.props;
// Sidebar state is shared per API version, across both sidebar copies. The
// base keeps two sites on one origin apart.
const navKey = `${import.meta.env.BASE_URL}|${nav.collection}${version ? `@${version}` : ""}`;

const versionStatus =
  collection && version
    ? await getVersionStatus(`${collection}@${version}`)
    : null;
const currentSiblingUrl =
  collection && version && coordinate
    ? ((await getApiVersionHead(collection, version, coordinate, Astro.request))?.canonical
        ?.url ?? null)
    : null;
const currentSiblingHref = withBase(currentSiblingUrl ?? "/", import.meta.env.BASE_URL);

// The rail column is reserved ONLY when it has content — a request sample or a
// response example (mirrors ApiCodeRail's own gate). A bodyless GET with no
// samples otherwise pins an empty sticky column at the page's right edge.
const hasRail =
  page.kind === "operation" &&
  (page.samples.length > 0 || page.responses.some((r) => r.example !== undefined));

const pagefindAttrs: Record<string, string> = {};
const pagefindDeprecated = !versionStatus?.isHidden && Boolean(versionStatus?.isDeprecated);
if (versionStatus?.isHidden) {
  pagefindAttrs["data-pagefind-ignore"] = "";
} else {
  pagefindAttrs["data-pagefind-body"] = "";
  if (versionStatus) {
    pagefindAttrs["data-pagefind-filter"] = `version:${versionStatus.version}`;
  }
}
---

{/* Mobile navigation — native <dialog> for free focus trap, escape, backdrop.
    It comes before the rail so the inline restore script after the rail
    finds both sidebar copies already parsed. */}
<dialog
  data-mobile-sidebar
  data-state="closed"
  class="group fixed inset-0 m-0 h-full w-full max-h-full max-w-full border-0 bg-transparent p-0 [&::backdrop]:bg-transparent"
  aria-label="API navigation"
>
  <div
    data-mobile-sidebar-panel
    class="flex h-full w-(--nb-sidebar-width) max-w-[85vw] -translate-x-full flex-col border-r border-border bg-card transition-transform duration-250 ease-out group-data-[state=open]:translate-x-0 motion-reduce:transition-none"
  >
    <div class="z-[1] flex items-center justify-between border-b border-border bg-card px-4 py-3">
      <span class="text-sm font-semibold text-foreground">Navigation</span>
      <button
        data-close-sidebar
        class="flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
        aria-label="Close navigation"
      >
        <Icon name="ph:x" class="h-5 w-5" />
      </button>
    </div>
    {/* The rail's tree is moved here while the drawer is open — one tree
        per page, one open/scroll state. */}
    <div data-nb-api-drawer-slot class="flex min-h-0 flex-1 flex-col [&>[data-nb-api-tree]]:min-h-0 [&>[data-nb-api-tree]]:flex-1 [&>[data-nb-api-tree]]:overflow-y-auto [&>[data-nb-api-tree]]:overscroll-contain"></div>
  </div>
</dialog>

<div class="flex w-full">
  {/* The rail keeps its open groups and scroll across pages: the inline script
      below restores them before paint, and `initNavSidebar` records them. It is
      excluded from the page transition so it never fades or replays. */}
  <aside
    transition:name="nb-api-sidebar"
    transition:animate="none"
    class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-60 shrink-0 flex-col border-r border-border bg-background md:flex lg:w-(--nb-sidebar-width)"
  >
    <div
      data-nb-api-tree
      data-nb-nav-state={navKey}
      data-nb-nav-build={navBuildId}
      data-nb-nav-scroller="nav"
      class="min-h-0 flex-1 overflow-y-auto overscroll-contain [scrollbar-color:gray_transparent] [scrollbar-width:thin]"
    >
      {/* A full tree filters in place, as the docs sidebar does. An on-demand
          tree holds only part of the API, so its filter searches the
          version's page list instead (`api-nav-filter.client`). */}
      <div class="pt-8 pb-12 pl-6 pr-4" data-nb-sidebar={nav.listHref ? undefined : ""}>
        <SidebarFilter data-nb-nav-list={nav.listHref && withBase(nav.listHref, import.meta.env.BASE_URL)} />
        {nav.listHref && (
          <>
            <p data-nb-nav-status role="status" hidden class="px-3 pb-2 text-xs text-muted-foreground"></p>
            <ul data-nb-nav-results hidden class="flex list-none flex-col gap-0.5 p-0"></ul>
            <template data-nb-nav-result>
              <li>
                <SidebarLink label="" href="/" class="px-1">
                  <ApiMethodChip slot="leading" method="GET" display="label" />
                </SidebarLink>
              </li>
            </template>
          </>
        )}
        <ApiSidebar items={nav.items} />
      </div>
    </div>
    <div class="pointer-events-none sticky bottom-0 h-8 bg-gradient-to-t from-background to-transparent"></div>
  </aside>
  {/* Inline and unbundled (`aria-hidden` keeps Astro from hoisting it) so it
      runs before the page paints and before the disclosures mount. */}
  <script is:inline aria-hidden="true" set:html={navStateScript} />

  {/* Reserve both desktop tracks before the streamed body/rail HTML arrives.
      Flex only reserves the rail's width once its later sibling is parsed,
      making long API bodies reflow sideways during navigation. */}
  <div data-api-layout class={cn(
    "flex min-w-0 flex-1 flex-col",
    hasRail && "min-[90rem]:grid min-[90rem]:grid-cols-[minmax(0,1fr)_29rem] 2xl:grid-cols-[minmax(0,1fr)_var(--nb-code-rail-width)]",
  )}>
    <main id="main-content" tabindex="-1" class="min-w-0 flex-1" {...pagefindAttrs}>
      <div class="mx-auto max-w-(--nb-content-max) px-4 md:px-8 2xl:px-16 pt-8 pb-12">
        {pagefindDeprecated && <span hidden data-pagefind-filter="status:deprecated"></span>}
        {versionStatus?.isDeprecated && (
          <div data-pagefind-ignore>
            <Banner
              variant="caution"
              class="mt-0 mb-6"
              content={`<strong>${versionStatus.version}</strong> is deprecated. <a href="${currentSiblingHref}">See the latest version</a>.`}
            />
          </div>
        )}
        <ApiBody page={page} />
      </div>
    </main>

    {/* Below 90rem the rail reflows inline beneath the body (samples are unique
        content, so unlike the TOC they stay in the no-JS HTML for crawlability);
        at 90rem+ it becomes the sticky right column. The left padding keeps overflow-y-auto
        from clipping the LayerCard's outset ring at the scroll edge. */}
    {hasRail && (
      <div class="mx-auto w-full max-w-(--nb-content-max) px-4 pb-12 md:px-8 min-[90rem]:mx-0 min-[90rem]:max-w-none min-[90rem]:sticky min-[90rem]:top-14 min-[90rem]:h-[calc(100vh-3.5rem)] min-[90rem]:w-[29rem] min-[90rem]:shrink-0 min-[90rem]:overflow-y-auto min-[90rem]:pt-8 min-[90rem]:pr-6 min-[90rem]:pb-8 min-[90rem]:pl-1 min-[90rem]:[scrollbar-color:gray_transparent] min-[90rem]:[scrollbar-width:thin] 2xl:w-(--nb-code-rail-width)">
        <ApiCodeRail
          responses={page.responses}
          samples={page.samples}
          title={page.title}
          method={page.method}
          coordinate={page.coordinate}
        />
      </div>
    )}
  </div>
</div>


<script>
  import { mount, lockScroll, unlockScroll, generateId, initNavSidebar } from "@cloudflare/nimbus-docs/client";
  import "@/components/ui/sidebar/sidebar.client";
  import "@/components/ui/api-sidebar/api-nav-filter.client";

  mount("[data-nb-nav-state]", initNavSidebar);

  const CLOSE_DURATION_MS = 250;
  const DESKTOP_QUERY = "(min-width: 48rem)";

  // mount() re-binds on every astro:page-load and tears down on
  // astro:before-swap, so the drawer survives client-side navigation.
  mount("[data-mobile-sidebar]", (root) => {
    const trigger = document.querySelector<HTMLElement>("[data-menu-btn]");
    if (!(root instanceof HTMLDialogElement) || !trigger) return () => {};
    const dialog = root;

    const controller = new AbortController();
    const { signal } = controller;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const prefersReducedMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!dialog.id) dialog.id = generateId("nb-api-mobile-sidebar");
    trigger.setAttribute("aria-controls", dialog.id);
    trigger.setAttribute("aria-expanded", "false");
    if (!trigger.hasAttribute("aria-haspopup")) trigger.setAttribute("aria-haspopup", "dialog");

    const clearTimer = () => {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = undefined;
      }
    };

    // One tree per page: the drawer borrows the rail's tree node while it
    // is open and returns it on close. `initNavSidebar` restores the scroll
    // whenever the tree is revealed.
    const tree = document.querySelector<HTMLElement>("[data-nb-api-tree]");
    const rail = tree?.parentElement ?? null;
    const drawerSlot = dialog.querySelector<HTMLElement>("[data-nb-api-drawer-slot]");
    const moveTreeToDrawer = () => {
      if (tree && drawerSlot && tree.parentElement !== drawerSlot) drawerSlot.append(tree);
    };
    const moveTreeToRail = () => {
      if (tree && rail && tree.parentElement !== rail) rail.prepend(tree);
    };

    const openSidebar = () => {
      clearTimer();
      if (dialog.open) {
        // Reclaim a drawer caught mid-slide-out rather than stranding it open.
        if (dialog.dataset.state === "closing") dialog.dataset.state = "open";
        return;
      }

      moveTreeToDrawer();
      dialog.showModal();
      dialog.dataset.state = "closed";
      lockScroll();
      trigger.setAttribute("aria-expanded", "true");

      // Flush the closed transform, then open in the same tick so the slide
      // starts on the next frame (a double rAF delays it by two frames).
      void dialog.offsetWidth;
      dialog.dataset.state = "open";

      dialog.querySelector<HTMLElement>("[data-close-sidebar]")?.focus({ preventScroll: true });
    };

    // Immediate close (no slide-out): reduced motion, or the viewport reaching desktop.
    const closeNow = () => {
      if (!dialog.open) return;
      clearTimer();
      dialog.close();
    };

    const closeSidebar = () => {
      if (!dialog.open || dialog.dataset.state === "closing") return;
      if (prefersReducedMotion()) {
        closeNow();
        return;
      }
      dialog.dataset.state = "closing";
      closeTimer = setTimeout(() => dialog.close(), CLOSE_DURATION_MS);
    };

    trigger.addEventListener("click", openSidebar, { signal });

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeSidebar();
    }, { signal });

    // Fires for Escape, close button, backdrop, and closeNow() — cleanup in one place.
    dialog.addEventListener("close", () => {
      clearTimer();
      dialog.dataset.state = "closed";
      moveTreeToRail();
      unlockScroll();
      trigger.setAttribute("aria-expanded", "false");
      trigger.focus();
    }, { signal });

    dialog.querySelectorAll<HTMLElement>("[data-close-sidebar]")
      .forEach((el) => el.addEventListener("click", closeSidebar, { signal }));

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) closeSidebar();
    }, { signal });

    // The hamburger is hidden past the desktop breakpoint; dismiss an open
    // drawer so it can't strand focus once its trigger disappears.
    const mql = window.matchMedia(DESKTOP_QUERY);
    mql.addEventListener("change", (event) => {
      if (event.matches) closeNow();
    }, { signal });
    if (mql.matches) closeNow();

    return () => {
      controller.abort();
      clearTimer();
      moveTreeToRail();
      trigger.setAttribute("aria-expanded", "false");
      // A swap while open never fires `close`; balance the scroll lock.
      if (dialog.open) unlockScroll();
    };
  });
</script>
