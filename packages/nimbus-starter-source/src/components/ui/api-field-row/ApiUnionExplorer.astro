---
import ApiFieldRow from "./ApiFieldRow.astro";
import type { ApiUnionView } from "@cloudflare/nimbus-docs/api";
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import { countLabel } from "./type-display";
import "./field-list.css";

interface Props {
  union: ApiUnionView;
  nested?: boolean;
  depth?: number;
}

const { union, nested = false, depth = 0 } = Astro.props;

const AUTO_OPEN_DEPTH = 1;

const entries =
  union.mapping && union.mapping.length > 0
    ? union.mapping.map((m) => ({ value: m.value, variant: m.variant }))
    : union.variants.map((v) => ({ variant: v, value: undefined as string | undefined }));
---

<div class={nested ? "fl-children fl-children--union" : ""}>
  <p class="fl-union-label">One of the following:</p>
  <ul class="fl-list">
    {entries.map(({ variant, value }, i) => {
      const hasFields = variant.fields && variant.fields.length > 0;
      const open = i === 0 && AUTO_OPEN_DEPTH >= depth + 1;
      return hasFields ? (
        <li class="fl-item fl-item--child">
          <div class="fl-body">
            <div class="fl-sig">
              {variant.href ? (
                <a href={withBase(variant.href, import.meta.env.BASE_URL)} class="fl-type-link fl-variant-link">{variant.label}</a>
              ) : (
                <span class="fl-name">{variant.label}</span>
              )}
              {value && <span class="fl-type">{value}</span>}
              <button type="button" class="fl-count" data-fl-toggle aria-expanded={open ? "true" : "false"}>
                <span class="fl-count-brace" aria-hidden="true">{"{"}</span><span class="fl-count-text">{countLabel(variant.fields!.length, "property")}</span><span class="fl-count-brace" aria-hidden="true">{"}"}</span>
              </button>
            </div>
            {variant.href && (
              <div class="fl-desc">
                <a href={withBase(variant.href, import.meta.env.BASE_URL)}>View {variant.label} schema →</a>
              </div>
            )}
            <details class="fl-expandable" open={open}>
              <summary class="fl-expand-trigger"></summary>
              <ul class="fl-list fl-children">
                {variant.fields!.map((f) => (
                  <ApiFieldRow field={f} depth={depth + 1} anchored={false} />
                ))}
              </ul>
              <span class="fl-fold-close" aria-hidden="true">{"}"}</span>
            </details>
          </div>
        </li>
      ) : (
        <li class="fl-item fl-item--child">
          <div class="fl-sig">
            {variant.href ? (
              <a href={withBase(variant.href, import.meta.env.BASE_URL)} class="fl-type-link fl-variant-link">{variant.label}</a>
            ) : (
              <span class="fl-name">{variant.label}</span>
            )}
            {value && <span class="fl-type">{value}</span>}
          </div>
        </li>
      );
    })}
  </ul>
</div>

<script>
  import "./api-field-row.client";
</script>
