---
import ApiUnionExplorer from "./ApiUnionExplorer.astro";
import { typeTokens, constraintPairs, isExpandable, contentsLabel, unionTitle, allowedValues } from "./type-display";
import type { ApiFieldView } from "@cloudflare/nimbus-docs/api";
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import "./field-list.css";

interface Props {
  field: ApiFieldView;
  depth?: number;
  /** Show the field's example: set on parameter rows. */
  showExample?: boolean;
}

const { field, depth = 0, showExample = false } = Astro.props;

const AUTO_OPEN_DEPTH = 1;
const expandable = isExpandable(field);
const startOpen = AUTO_OPEN_DEPTH >= depth;
const toks = typeTokens(field);
const constraints = constraintPairs(field.constraints);
const allowed = allowedValues(field.enum);
const omitted = field.childCount - field.children.length;
const detail = (v: unknown): string => JSON.stringify(v);
// Constraints, default and example share one line, in that order. Body field
// examples aren't shown: the code rail's request and response examples carry
// them. Parameter rows show theirs, since samples leave optional ones out.
const meta = [
  ...constraints,
  ...(field.default !== undefined ? [{ name: "default", value: detail(field.default) }] : []),
  ...(showExample && field.example !== undefined ? [{ name: "example", value: detail(field.example) }] : []),
];

const linkSvg = `<svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`;
---

<li
  id={field.anchor}
  class:list={["fl-item", depth > 0 && "fl-item--child"]}
>
  <div class="fl-row">
    {field.anchor && (
      <a
        href={`#${field.anchor}`}
        class="fl-anchor"
        aria-label={`Link to ${field.name}`}
        set:html={linkSvg}
      />
    )}
    <div class="fl-body">
      <div class="fl-sig">
        <div
          class:list={["fl-name", field.deprecated && "fl-name--deprecated"]}
          title={field.union ? unionTitle(field.union) : undefined}
        >
          {field.name}
        </div>
        {field.deprecated && <div class="fl-deprecated-badge">deprecated</div>}
        {!field.required && !field.deprecated && <div class="fl-optional">optional</div>}
        {toks.length > 0 && (
          <div class="fl-type-group">
            {toks.map((t) =>
              t.href ? (
                <a href={withBase(t.href, import.meta.env.BASE_URL)} class="fl-type-link" title={t.title}>{t.text}</a>
              ) : (
                <div class="fl-type" title={t.title}>{t.text}</div>
              )
            )}
          </div>
        )}
        {field.nullable && <div class="fl-nullable">or null</div>}
        {(field.required || expandable) && (
          /* Kept on one line so the brace never wraps away from "required". */
          <div class="fl-sig-tail">
            {field.required && <div class="fl-required">required</div>}
            {expandable && (
              <button type="button" class="fl-count" data-fl-toggle data-pagefind-ignore aria-expanded={startOpen ? "true" : "false"}>
                <span class="fl-count-brace" aria-hidden="true">{"{"}</span><span class="fl-count-text">{contentsLabel(field.childCount, field.union)}</span><span class="fl-count-brace" aria-hidden="true">{"}"}</span>
              </button>
            )}
          </div>
        )}
      </div>

      {field.descriptionHtml && (
        <div class="fl-desc" set:html={field.descriptionHtml} />
      )}

      {allowed && (
        <div class="fl-constraints">Allowed values: <span class="fl-constraint-value">{allowed}</span></div>
      )}

      {meta.length > 0 && (
        <div class="fl-constraints">
          {meta.map((c, i) => (
            <span>{i > 0 && " · "}{c.name}: <span class="fl-constraint-value">{c.value}</span></span>
          ))}
        </div>
      )}

      {expandable && (
        <details class="fl-expandable" open={startOpen}>
          {/* Toggled by the { n properties } button on the signature line. */}
          <summary class="fl-expand-trigger"></summary>
          {/* Fields beside a union come first; the options add to them. */}
          {(field.children.length > 0 || field.truncated) && (
            <ul class="fl-list fl-children">
              {field.children.map((child) => (
                <Astro.self field={child} depth={depth + 1} />
              ))}
              {field.truncated && (
                <li class="fl-truncated">… {omitted} more field(s) omitted</li>
              )}
            </ul>
          )}
          {field.union && (
            <ApiUnionExplorer union={field.union} depth={depth} nested afterFields={field.children.length > 0} />
          )}
          <span class="fl-fold-close" aria-hidden="true" data-pagefind-ignore>{"}"}</span>
        </details>
      )}
    </div>
  </div>
</li>

<script>
  import "./api-field-row.client";
</script>
