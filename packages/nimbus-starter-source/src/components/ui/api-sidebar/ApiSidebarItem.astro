---
/**
 * ApiSidebarItem — the API rail's per-node walker. It renders `ApiNavItem`s
 * through the SAME atoms as the docs sidebar (`SidebarGroupHeader`,
 * `SidebarLink`) so the two rails are one visual language; the only
 * API-specific decoration is the leading `ApiMethodChip` on operation leaves.
 * Groups are native `<details>`; a group with its own page lists it as the
 * group's first child, labelled "Overview". Open/active state is pre-resolved
 * by `getApiNav` (`expanded` marks the active trail, `active` the current
 * node), so this maps those flags straight onto the shared atoms.
 *
 * Under `sidebar: "on-demand"`, a collapsed group arrives `deferred`, with no
 * children and a `childrenHref`: the page whose sidebar lists them. It renders
 * as a closed group whose list holds only the Overview row; `initNavSidebar`
 * (mounted by `ApiLayout`) fills the list from that page when the group
 * opens. Without JavaScript, the Overview row still reaches its page.
 */
import SidebarGroupHeader from "@/components/ui/sidebar/SidebarGroupHeader.astro";
import SidebarLink from "@/components/ui/sidebar/SidebarLink.astro";
import ApiMethodChip from "./ApiMethodChip.astro";
import type { ApiNavItem } from "@cloudflare/nimbus-docs/api";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

interface Props {
  item: ApiNavItem;
}

const { item } = Astro.props;
const deferred = Boolean(item.deferred && item.childrenHref);
const hasChildren = item.children.length > 0 || deferred;
// `expanded` ⟺ ancestor of the active node; `active` ⟺ the current node. Both
// mean "on the active trail" for header emphasis, and either opens the group.
const onActiveTrail = Boolean(item.expanded || item.active);
---

{
  hasChildren ? (
    <details
      data-nb-sidebar-group
      data-nb-nav-group={item.coordinate}
      data-nb-nav-src={deferred ? withBase(item.childrenHref!, import.meta.env.BASE_URL) : undefined}
      open={onActiveTrail || undefined}
    >
      <SidebarGroupHeader label={item.label} hasActive={onActiveTrail} deprecated={item.deprecated} />
      <ul class="nb-sidebar-list">
        {item.href && (
          <li>
            <SidebarLink label="Overview" href={item.href} isCurrent={item.active} />
          </li>
        )}
        {!deferred &&
          item.children.map((child) => (
            <li>
              <Astro.self item={child} />
            </li>
          ))}
      </ul>
    </details>
  ) : (
    <SidebarLink
      label={item.label}
      href={item.href ?? "#"}
      isCurrent={item.active}
      data-nb-filter-text={item.method}
      class={item.deprecated ? "px-1 line-through" : "px-1"}
    >
      <ApiMethodChip slot="leading" method={item.method} display="label" />
    </SidebarLink>
  )
}
