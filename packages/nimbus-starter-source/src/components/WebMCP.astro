---
import { capabilities, options } from "virtual:nimbus/agent-capabilities";
import { config, searchIndex, searchVersionChoices } from "virtual:nimbus/config";
---

{capabilities.search === "pagefind" && (
  <meta name="nimbus-webmcp" content={JSON.stringify({
    search: capabilities.search,
    versions: capabilities.versions,
    site: options.site,
    title: options.title,
    base: options.base,
    bundle: searchIndex.bundle,
    merge: searchIndex.merge,
  })} />
)}
{capabilities.search === "ai-search" && config.search && config.search.provider === "ai-search" && (
  <meta name="nimbus-webmcp" content={JSON.stringify({
    search: capabilities.search,
    versions: Object.keys(searchVersionChoices),
    versionChoices: searchVersionChoices,
    endpoint: config.search.endpoint,
    site: options.site,
    title: options.title,
    base: options.base,
  })} />
)}

<script>
  import { initDocumentationWebMcp, mount } from "@cloudflare/nimbus-docs/client";
  mount('meta[name="nimbus-webmcp"]', (element) => {
    const options = JSON.parse(element.getAttribute("content")!);
    return initDocumentationWebMcp(options);
  });
</script>
