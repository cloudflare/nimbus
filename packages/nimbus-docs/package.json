		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		},
		"./markdown": {
			"types": "./dist/markdown.d.ts",
			"import": "./dist/markdown.js"
		},
		"./og": {
			"types": "./dist/og.d.ts",
			"import": "./dist/og.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		},
		"./api": {
			"types": "./dist/api.d.ts",
			"import": "./dist/api.js"
		},
		"./lib/pkgm": {
			"types": "./dist/lib/pkgm.d.ts",
			"import": "./dist/lib/pkgm.js"
		},
		"./components/NimbusHead.astro": "./src/components/NimbusHead.astro",
		"./components/Icon.astro": "./src/components/Icon.astro",
		"./components/NestedContent.astro": "./src/components/NestedContent.astro",
		"./styles/math.css": "./src/styles/math.css"
	},
	"files": [
		"dist",
		"src/components",
		"src/styles"
	],
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test --test-concurrency=4 \"test/**/*.test.ts\"",
		"pull:api-fixtures": "node scripts/pull-api-fixtures.mjs",
		"prepack": "tsdown"
	},
