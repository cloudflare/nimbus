{
	"name": "@cloudflare/nimbus-docs",
	"version": "0.20.0",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"description": "Nimbus is a documentation framework for Astro: docs for humans and agents, in your repo.",
	"keywords": [
		"astro",
		"documentation",
		"docs",
		"mdx",
		"static-site",
		"docs-framework",
		"openapi",
		"api-reference",
		"llms-txt",
		"ai-agents"
	],
	"homepage": "https://nimbus-docs.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cloudflare/nimbus.git",
		"directory": "packages/nimbus-docs"
	},
	"bugs": {
		"url": "https://github.com/cloudflare/nimbus/issues"
	},
	"license": "MIT",
	"author": "Mohamed Hassan",
	"bin": {
		"nimbus-docs": "./dist/cli/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js"
		},
		"./agent-endpoints": {
			"types": "./dist/agent-endpoints.d.ts",
			"import": "./dist/agent-endpoints.js"
		},
		"./publication": {
			"types": "./dist/publication.d.ts",
