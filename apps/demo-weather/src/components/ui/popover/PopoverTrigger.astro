---
/**
 * PopoverTrigger — button that toggles the popover.
 * Must be a direct child of Popover.
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {}

// A composing component can pass its own `data-slot` in place of this one.
const { class: className, "data-slot": slot = "popover-trigger", ...attrs } = Astro.props;
---

<button
  data-slot={slot}
  type="button"
  data-popover-trigger
  class={cn(className)}
  {...attrs}
>
  <slot />
</button>
