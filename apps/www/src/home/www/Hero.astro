---
/* The homepage hero: the copy reads as a page being written together. Who's
   editing sits above it, and their cursors sit in the text, so the first thing
   a reader sees is the product's own idea: you and your agents on one page. */
import { Code } from "@/components/ui/code";
import { cmd, hero } from "../variants/copy";

// The tagline's last word carries the agent's selection.
const cut = hero.line2.lastIndexOf(" ") + 1;
const [lead, last] = [hero.line2.slice(0, cut), hero.line2.slice(cut)];
---
<section class="pt-16 pb-20 md:pt-24" data-hero>
  <div class="mb-6 flex items-center gap-2.5 text-[12px] text-muted-foreground" aria-hidden="true">
    <div class="flex -space-x-1.5">
      <span class="flex size-6 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background ring-2 ring-background">Y</span>
      <span class="flex size-6 items-center justify-center rounded-full bg-sky-600 text-[10px] font-medium text-white ring-2 ring-background">A</span>
      <span class="flex size-6 items-center justify-center rounded-full bg-amber-500 text-[10px] font-medium text-white ring-2 ring-background">R</span>
    </div>
    <span>You, an agent and a reviewer are editing</span>
  </div>
  <h1 class="text-[40px] leading-[1.06] tracking-[-0.03em]! md:text-[60px]">
    <span class="block">{hero.line1}</span>
    <span class="block text-muted-foreground">{lead}<mark class="rounded-sm bg-sky-600/12 px-0.5 text-inherit ring-1 ring-sky-600/30">{last}</mark><span class="caret" data-who="you" aria-hidden="true"></span></span>
  </h1>
  <p class="mt-5 max-w-lg text-pretty text-[17px] leading-7 text-foreground/70">Nimbus is a documentation framework for Astro: docs for humans and agents, in your repo. Write with your team. And your agents. Every page up to your standard<span class="caret" data-who="agent" aria-hidden="true"></span></p>
  <div class="mt-8 max-w-xl [&_.nb-code-figure]:my-0!"><Code code={cmd} lang="sh" /></div>
</section>

<style>
  .caret { position: relative; display: inline-block; width: 2px; height: 0.9em; margin-left: 2px; vertical-align: -0.1em; background: var(--c); animation: hero-blink 1.1s steps(1) infinite; }
  .caret::after { content: attr(data-who); position: absolute; left: 0; bottom: 100%; margin-bottom: 2px; padding: 0 5px; border-radius: 3px 3px 3px 0; background: var(--c); color: #fff; font: 500 11px/16px var(--nb-font-sans); letter-spacing: 0; }
  .caret[data-who="you"] { --c: var(--nb-foreground); }
  .caret[data-who="you"]::after { color: var(--nb-background); }
  .caret[data-who="agent"] { --c: var(--color-sky-600); animation-delay: 0.5s; }
  @keyframes hero-blink { 50% { background-color: transparent; } }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }
</style>
