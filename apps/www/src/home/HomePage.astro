---
/**
 * The nimbus-docs.com homepage at `/`; astro.config.ts injects it as its own
 * route.
 */
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import WwwBody from "./www/WwwBody.astro";
import WebMCP from "@/components/WebMCP.astro";
import { description } from "./www/content";

const title = "Nimbus · The authoring tool for docs";
const canonical = new URL("/", Astro.site).href;
// The site card from `src/pages/og.png.ts`.
const socialImage = new URL("/og.png", Astro.site).href;
const socialImageAlt = "Nimbus: the authoring tool for docs.";
// Who the site is, for agents and search engines.
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Nimbus",
  description,
  url: canonical,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: ["https://github.com/cloudflare/nimbus"],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="is-agentic-site-type" content="content" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <script type="application/ld+json" set:html={jsonLd} />
    <WebMCP />
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <WwwBody />
  </body>
</html>
