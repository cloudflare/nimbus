---
/**
 * /blog and /blog/<slug>, rendered on request like the docs, from the `blog`
 * collection. A post carries `BlogPosting` structured data beside its
 * breadcrumbs; the index lists posts newest first.
 */
import { getCollection, type CollectionEntry } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { components } from "../../components";
import { breadcrumbListJsonLd } from "@/lib/breadcrumb-json-ld";
import { authorMeta, authorProfiles, blogPostingJsonLd, postDate } from "@/lib/blog";
import { getCollectionPage, getSidebar, getTOC, withBase } from "@cloudflare/nimbus-docs/runtime";

const page = await getCollectionPage(Astro, "blog");
if (page instanceof Response) return page;
const { entry, Content, headings, markdownUrl, ogImageUrl } = page;
const isIndex = entry.id === "index";
const path = isIndex ? "/blog" : `/blog/${entry.id}`;

const sidebar = await getSidebar(path);
const posts = (await getCollection("blog", (e: CollectionEntry<"blog">) => e.id !== "index" && !e.data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0) || a.id.localeCompare(b.id),
);
const index = posts.findIndex((post) => post.id === entry.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const prevNext = isIndex
  ? { prev: undefined, next: undefined }
  : {
      prev: newer ? { label: newer.data.title, href: `/blog/${newer.id}` } : undefined,
      next: older ? { label: older.data.title, href: `/blog/${older.id}` } : undefined,
    };

const breadcrumbs = isIndex
  ? []
  : [
      { label: "Home", href: "/" },
      { label: "Blog", href: "/blog" },
      { label: entry.data.title, href: path },
    ];
const socialImage = entry.data.socialImage ?? ogImageUrl;
const head = [
  ...entry.data.head,
  ...breadcrumbListJsonLd(breadcrumbs, Astro.site, import.meta.env.BASE_URL, path),
  ...(isIndex ? [] : blogPostingJsonLd(entry, Astro.site, import.meta.env.BASE_URL, socialImage)),
  ...(isIndex ? [] : authorMeta(entry.data.author)),
];
const author = authorProfiles(entry.data.author);
const toc = isIndex ? false : getTOC(headings, entry.data.tableOfContents === false ? undefined : entry.data.tableOfContents);
const href = (to: string) => withBase(to, import.meta.env.BASE_URL);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  head={head}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={entry.data.lastUpdated}
  draft={entry.data.draft}
  collection="blog"
  entryId={entry.id}
>
  {!isIndex && entry.data.date && (
    <p class="text-sm text-muted-foreground">
      <time datetime={entry.data.date.toISOString().slice(0, 10)}>{postDate(entry.data.date)}</time> · {entry.data.author}
      {author && (
        <>
          {" · "}<a href={author.x} rel="author" class="underline underline-offset-2 hover:text-foreground">{author.handle}</a>
          {" · "}<a href={author.linkedin} rel="author" class="underline underline-offset-2 hover:text-foreground">LinkedIn</a>
        </>
      )}
    </p>
  )}
  <Content components={components} />
  {isIndex && (
    <ul class="not-prose mt-8 flex flex-col gap-6" role="list">
      {posts.map((post) => (
        <li>
          <a href={href(`/blog/${post.id}`)} class="group block">
            <span class="block text-lg font-medium text-foreground group-hover:underline">{post.data.title}</span>
            {post.data.date && <time class="block text-sm text-muted-foreground" datetime={post.data.date.toISOString().slice(0, 10)}>{postDate(post.data.date)}</time>}
            <span class="mt-1 block text-muted-foreground">{post.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</DocsLayout>
