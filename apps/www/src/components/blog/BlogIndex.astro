---
/**
 * /blog's body: the hero, the newest post large, then the rest in a grid
 * whose cells share single rules, like the community recipes showcase. Its
 * Markdown version is src/pages/blog/index.md.ts.
 */
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import PostCover from "./PostCover.astro";
import PostMeta from "./PostMeta.astro";
import PostGrid from "./PostGrid.astro";
import { BLOG, postHref, type Post } from "@/lib/blog";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const [featured, ...rest] = posts;
const href = (path: string) => withBase(path, import.meta.env.BASE_URL);
---

<div class="nb-blog not-prose">
  <header class="nb-blog-hero">
    <div class="nb-blog-wrap">
      <h1 class="nb-blog-title">{BLOG.title}</h1>
      <p class="nb-blog-lead">{BLOG.description}</p>
      <a class="nb-blog-feed" href={href("/blog/rss.xml")}>
        <Icon name="ph:rss-simple" class="size-4" />
        RSS feed
      </a>
    </div>
  </header>

  {featured && (
    <section class="nb-blog-wrap nb-blog-section" aria-label="The newest post">
      <a href={href(postHref(featured))} class="nb-blog-feature group">
        <PostCover id={featured.id} size="feature" class="nb-blog-feature-cover" />
        <div class="nb-blog-feature-copy">
          <PostMeta post={featured} label="Newest" />
          <h2 class="nb-blog-feature-title">{featured.data.title}</h2>
          <p class="nb-blog-feature-desc">{featured.data.description}</p>
          <span class="nb-blog-read">
            Read the post
            <Icon name="ph:arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
          </span>
        </div>
      </a>
    </section>
  )}

  {rest.length > 0 && (
    <div class="nb-blog-wrap nb-blog-more">
      <PostGrid id="nb-blog-more" title="More posts" posts={rest} />
    </div>
  )}
</div>

<style is:global>
  .nb-blog {
    --nb-blog-display: "Bricolage Grotesque Variable", ui-sans-serif, system-ui, sans-serif;
  }
  .nb-blog-wrap {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* The hero: a faint dot grid fading from the middle, as on the showcase. */
  .nb-blog-hero {
    padding: 4.5rem 0 4rem;
    border-bottom: 1px solid var(--nb-border);
    background:
      radial-gradient(ellipse at 30% 40%, transparent 0, var(--nb-background) 72%),
      radial-gradient(color-mix(in oklch, var(--nb-foreground) 14%, transparent) 1px, transparent 1px) 0 0 / 16px 16px,
      var(--nb-background);
  }
  @media (min-width: 768px) {
    .nb-blog-hero {
      padding: 6rem 0 5rem;
    }
  }
  .nb-blog-title {
    font-family: var(--nb-blog-display);
    font-size: clamp(2.5rem, 1.7rem + 3.2vw, 4rem);
    line-height: 1.04;
    font-weight: 400;
    letter-spacing: -0.035em;
    color: var(--nb-foreground);
    text-wrap: balance;
  }
  .nb-blog-lead {
    max-width: 38rem;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: color-mix(in oklch, var(--nb-foreground) 70%, transparent);
    text-wrap: pretty;
  }
  .nb-blog-feed {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--nb-foreground);
    text-decoration: underline;
    text-decoration-color: var(--nb-border);
    text-underline-offset: 4px;
  }
  .nb-blog-feed:hover {
    text-decoration-color: currentColor;
  }

  .nb-blog-section {
    padding-top: 3.5rem;
  }
  @media (min-width: 768px) {
    .nb-blog-section {
      padding-top: 4.5rem;
    }
  }

  /* The newest post: cover and copy side by side from md. */
  .nb-blog-feature {
    display: grid;
    gap: 2rem;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  @media (min-width: 900px) {
    .nb-blog-feature {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }
  .nb-blog-feature-cover {
    transition: transform 300ms cubic-bezier(0.2, 0, 0, 1);
  }
  .nb-blog-feature:hover .nb-blog-feature-cover {
    transform: translateY(-2px);
  }
  .nb-blog-feature-title {
    margin-top: 1rem;
    font-family: var(--nb-blog-display);
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: -0.025em;
    color: var(--nb-foreground);
    text-wrap: balance;
    /* As on the cards: the underline is there from the start, clear, so
       hovering only darkens it and nothing shifts. Heavier, for the size. */
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
    transition: text-decoration-color 150ms ease;
  }
  .nb-blog-feature:hover .nb-blog-feature-title {
    text-decoration-color: currentColor;
  }
  .nb-blog-feature-desc {
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.75rem;
    color: color-mix(in oklch, var(--nb-foreground) 70%, transparent);
    text-wrap: pretty;
  }
  .nb-blog-read {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.5rem;
    font-weight: 500;
    color: var(--nb-foreground);
  }

  /* More posts sits further below the newest post than the newest post
     sits below the hero: a new section, not the next item. */
  .nb-blog-more {
    padding-top: 5rem;
    padding-bottom: 1rem;
  }
  @media (min-width: 768px) {
    .nb-blog-more {
      padding-top: 6rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nb-blog-feature-cover,
    .nb-blog-feature-title {
      transition: none;
    }
  }
</style>
