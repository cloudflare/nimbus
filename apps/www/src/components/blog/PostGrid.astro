---
/**
 * A titled grid of posts: /blog's "More posts" and the list at the end of a
 * post. The title row and the grid sit 32px apart; rows 48px, columns 32px,
 * and 40px between posts on a phone, where they stack.
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import PostCard from "./PostCard.astro";
import type { Post } from "@/lib/blog";

interface Props {
  id: string;
  title: string;
  posts: Post[];
  cover?: boolean;
  /** Link to /blog from the title row. */
  all?: boolean;
}

const { id, title, posts, cover = true, all = false } = Astro.props;
---

<section class="nb-grid" aria-labelledby={id}>
  <div class="nb-grid-head">
    <h2 id={id} class="nb-grid-title">{title}</h2>
    {all && (
      <a href={withBase("/blog/", import.meta.env.BASE_URL)} class="nb-grid-all group">
        All posts
        <Icon name="ph:arrow-right" class="size-3.5 transition-transform group-hover:translate-x-0.5" />
      </a>
    )}
  </div>
  <ul class="nb-grid-list">
    {posts.map((post) => (
      <li><PostCard post={post} cover={cover} /></li>
    ))}
  </ul>
</section>

<style is:global>
  .nb-grid-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .nb-grid-title {
    font-family: "Bricolage Grotesque Variable", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--nb-foreground);
  }
  .nb-grid-all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--nb-muted-foreground);
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease;
  }
  .nb-grid-all:hover {
    color: var(--nb-foreground);
  }
  .nb-grid-list {
    display: grid;
    gap: 2.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .nb-grid-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem 2rem;
    }
  }
  @media (min-width: 1024px) {
    .nb-grid-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
