---
/**
 * One post in a list: date and reading time, title (two lines at most),
 * description (three). With a
 * cover on /blog; ruled instead at the end of a post, where a cover would
 * compete with the post just read. Spacing runs on a 4px grid: 20px from the
 * cover or rule to the date, 8px between the lines of text.
 */
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import PostCover from "./PostCover.astro";
import PostMeta from "./PostMeta.astro";
import { postHref, type Post } from "@/lib/blog";

interface Props {
  post: Post;
  cover?: boolean;
}

const { post, cover = true } = Astro.props;
---

<a href={withBase(postHref(post), import.meta.env.BASE_URL)} class:list={["nb-card", !cover && "nb-card-ruled"]}>
  {cover && <PostCover id={post.id} class="nb-card-cover" />}
  <PostMeta post={post} />
  <h3 class="nb-card-title">{post.data.title}</h3>
  <p class="nb-card-desc">{post.data.description}</p>
</a>

<style is:global>
  .nb-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .nb-card-cover {
    margin-bottom: 1.25rem;
    transition: transform 300ms cubic-bezier(0.2, 0, 0, 1);
  }
  .nb-card:hover .nb-card-cover {
    transform: translateY(-2px);
  }
  .nb-card-ruled {
    padding-top: 1.25rem;
    border-top: 1px solid var(--nb-border);
  }
  .nb-card-title {
    margin-top: 0.5rem;
    font-family: "Bricolage Grotesque Variable", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--nb-foreground);
    text-wrap: balance;
    /* Two lines at most; the underline is there from the start, clear, so
       hovering only darkens it and nothing shifts. */
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    padding-bottom: 0.125rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
    transition: text-decoration-color 150ms ease;
  }
  .nb-card:hover .nb-card-title {
    text-decoration-color: currentColor;
  }
  /* Three lines at most, so a row of cards keeps one rhythm. */
  .nb-card-desc {
    display: -webkit-box;
    margin-top: 0.5rem;
    overflow: hidden;
    font-size: 0.9375rem;
    line-height: 1.5rem;
    color: var(--nb-muted-foreground);
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  @media (prefers-reduced-motion: reduce) {
    .nb-card-cover,
    .nb-card-title {
      transition: none;
    }
  }
</style>
