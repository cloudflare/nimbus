---
/**
 * Card — a titled panel, optionally with an icon.
 *
 *   <Card title="Write a page" icon="ph:pencil-simple">Create an .mdx file.</Card>
 *
 * For a rich title or a custom mark, use the `title` and `icon` slots.
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article"> {
  title?: string;
  /** Iconify icon name, e.g. `ph:lightning`. */
  icon?: string;
}

const { title, icon, class: className, ...attrs } = Astro.props;
const hasIcon = Boolean(icon) || Astro.slots.has("icon");
const hasTitle = Boolean(title) || Astro.slots.has("title");
---

<article data-slot="card" class={cn("my-4 rounded-lg bg-card p-5 shadow-sm ring ring-border", className)} {...attrs}>
  {hasIcon && (
    <div data-slot="card-icon" class="mb-2.5 text-brand">
      <slot name="icon">{icon && <Icon name={icon} class="block size-6" />}</slot>
    </div>
  )}
  {hasTitle && (
    <h3 data-slot="card-title" class="m-0 text-base font-semibold leading-snug text-foreground">
      <slot name="title">{title}</slot>
    </h3>
  )}
  <div data-slot="card-content" class:list={["text-sm leading-normal text-muted-foreground", hasTitle && "mt-1.5"]}>
    <slot />
  </div>
</article>
