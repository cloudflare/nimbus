---
/**
 * The community recipes, grouped by the GitHub owner in each recipe's URL. Its
 * Markdown (the page's `.md`, MCP, `llms-full.txt`) comes from
 * `src/lib/community-recipes-markdown.ts`, which reads the same listing.
 */
import { PackageManagers } from "@/components/ui/package-managers";
import { communityRecipes } from "@/data/community-recipes";
import { EMPTY_STATE } from "@/lib/community-recipes-markdown";
---

{communityRecipes.length === 0 ? (
  <p>{EMPTY_STATE}</p>
) : (
  <div class="not-prose my-6 space-y-8" data-slot="community-recipes">
    {communityRecipes.map((owner) => (
      <section aria-labelledby={`recipes-${owner.owner.toLowerCase()}`}>
        <a
          id={`recipes-${owner.owner.toLowerCase()}`}
          href={owner.profileUrl}
          class="inline-flex items-center gap-2 text-sm font-medium text-foreground hover:underline"
        >
          <img src={owner.avatarUrl} alt="" width="24" height="24" loading="lazy" class="size-6 rounded-full bg-muted" />
          {owner.owner}
        </a>
        <ul class="mt-3">
          {owner.recipes.map((recipe) => (
            <li class="pb-6 last:pb-0">
              <p class="text-sm">
                <span class="font-medium text-foreground">{recipe.name}</span>
                <span class="text-muted-foreground"> — {recipe.description} </span>
                <a href={recipe.repoUrl} class="text-muted-foreground underline underline-offset-2 hover:text-foreground">{recipe.owner}/{recipe.repo}</a>
              </p>
              <div class="mt-2 [&>*]:my-0">
                <PackageManagers pkg="@cloudflare/nimbus-docs" type="exec" args={`add ${recipe.url}`} />
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
)}
