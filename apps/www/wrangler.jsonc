{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimbus-docs",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  // The Astro build adds the Worker and its assets; unknown URLs reach the
  // Worker, which answers with the 404 page.
  "assets": {
    "not_found_handling": "none",
  },
  "previews": {},
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
