{
  "name": "@nimbus/www",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nimbus docs site + registry host. Deployed to https://nimbus-docs.com via Cloudflare Workers Static Assets.",
  "scripts": {
    "generate-registry": "tsx scripts/generate-registry.ts",
    "dev": "pnpm run generate-registry && astro dev",
    "build": "pnpm run generate-registry && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --import tsx --test \"registry/**/*.test.ts\"",
    "preview:cf": "wrangler dev",
    "predeploy": "pnpm --filter nimbus-docs build && astro check && pnpm run build",
    "deploy": "wrangler deploy",
    "build:workers": "pnpm run predeploy && printf '%s\\n' \"${WORKERS_CI_COMMIT_SHA:?}\" > dist/_nimbus-preview-sha.txt && printf '\\n/*\\n  X-Robots-Tag: noindex\\n' >> dist/_headers"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.0",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@cloudflare/nimbus-docs": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "^5",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "7.3.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "satori": "^0.26.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/mdx": "~8.0.0",
    "@notionhq/client": "^5.27.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "notion-to-md": "^3.1.9",
    "pagefind": "^1.5.2",
    "satteri": "^0.10.5",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.149.0"
  }
}
