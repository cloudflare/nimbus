{
  "name": "@nimbus/www",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nimbus docs site + registry host. Deployed to https://nimbus-docs.com via Cloudflare Workers Static Assets.",
  "scripts": {
    "generate-registry": "tsx scripts/generate-registry.ts",
    "dev": "pnpm run generate-registry && astro dev",
    "build": "pnpm run generate-registry && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --import tsx --test \"registry/**/*.test.ts\"",
    "preview:cf": "wrangler dev",
    "predeploy": "pnpm --filter nimbus-docs build && astro check && pnpm run build",
    "deploy": "wrangler deploy",
    "build:workers": "WWW_NOINDEX=1 pnpm run predeploy && printf '%s\\n' \"${WORKERS_CI_COMMIT_SHA:?}\" > dist/client/_nimbus-preview-sha.txt && printf '\\n/*\\n  X-Robots-Tag: noindex\\n' >> dist/client/_headers"
  },
  "dependencies": {
    "@astrojs/cloudflare": "~14.4.3",
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@cloudflare/nimbus-docs": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "^5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/ph": "^1.2.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "7.4.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "tailwind-merge": "^3.7.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "~8.1.2",
    "@notionhq/client": "^5.30.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "notion-to-md": "^3.1.9",
    "pagefind": "^1.6.0",
    "satteri": "^0.11.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "wrangler": "^4.156.1"
  }
}
