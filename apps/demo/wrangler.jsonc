{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimbus-demo-weather",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  // The site's own subdomain. `site` in astro.config.ts matches it.
  "routes": [{ "pattern": "demo.nimbus-docs.com", "custom_domain": true }],
  "previews": {},
  "preview_urls": false,
}
