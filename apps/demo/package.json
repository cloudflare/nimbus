{
  "name": "@nimbus/demo-weather",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nimbus demo: Sample Co's weather API docs, with a large, versioned API reference.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "deploy": "wrangler deploy",
    "build:workers": "DEMO_NOINDEX=1 pnpm --filter \"@nimbus/demo-weather...\" build && printf '\\n/*\\n  X-Robots-Tag: noindex\\n' >> dist/client/_headers",
    "generate-spec": "tsx spec/generate.ts",
    "fixture-api:routes": "node fixture-api/build-routes.mjs",
    "fixture-api:test": "node --import tsx --test \"fixture-api/test/**/*.test.ts\"",
    "fixture-api:dev": "wrangler dev --config fixture-api/wrangler.jsonc --port 8787",
    "fixture-api:deploy": "wrangler deploy --config fixture-api/wrangler.jsonc",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "~14.4.2",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@cloudflare/nimbus-docs": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "@modelcontextprotocol/server": "^2.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@scalar/openapi-parser": "0.29.16",
    "astro": "7.4.7",
    "clsx": "^2.1.1",
    "openapi-sampler": "1.7.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "pagefind": "^1.5.2",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.153.0",
    "yaml": "2.9.1"
  }
}
