---
/**
 * ShortcutsToggle — lets a reader turn single-key shortcuts (`/`, `[`, `]`) off,
 * as WCAG 2.1.4 asks of page-wide single keys. Single keys bind page-wide only
 * while a page has this switch. Renders nothing when `src/lib/shortcuts.ts`
 * has no single-key shortcut. `compact` keeps the name for screen readers and
 * the tooltip, for a crowded bar such as the header.
 */
import { isSingleKey, shortcutLabel } from "@cloudflare/nimbus-docs/client";
import { cn } from "@/lib/cn";
import { shortcuts } from "@/lib/shortcuts";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  /** Show only the switch, and its keys from `md` up. */
  compact?: boolean;
}

const { class: className, compact = false, ...attrs } = Astro.props;
const singles = Object.values(shortcuts).filter(isSingleKey).map(shortcutLabel);
---

{singles.length > 0 && (
  <button
    type="button"
    data-nb-shortcuts-toggle
    data-slot="shortcuts-toggle"
    aria-pressed="true"
    title={compact ? "Single-key shortcuts" : undefined}
    class={cn(
      "inline-flex items-center gap-2 rounded-md px-1.5 py-0.5 text-xs text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring",
      className,
    )}
    {...attrs}
  >
    <span class="relative inline-flex h-3.5 w-6 shrink-0 items-center rounded-full bg-muted-foreground/30 transition-colors" aria-hidden="true">
      <span class="nb-shortcuts-knob ms-0.5 h-2.5 w-2.5 rounded-full bg-card shadow-sm transition-transform"></span>
    </span>
    <span class={compact ? "sr-only" : undefined}>Single-key shortcuts</span>
    <span class={cn("font-mono", compact && "hidden md:inline")} dir="ltr" aria-hidden="true">{singles.join(" ")}</span>
  </button>
)}

<script>
  import "./shortcuts-toggle.client";
</script>

<style>
  [data-nb-shortcuts-toggle][aria-pressed="true"] > span:first-child {
    background: var(--nb-success);
  }
  [data-nb-shortcuts-toggle][aria-pressed="true"] .nb-shortcuts-knob {
    transform: translateX(0.625rem);
  }
  @media (prefers-reduced-motion: reduce) {
    .nb-shortcuts-knob {
      transition: none;
    }
  }
</style>
